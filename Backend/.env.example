# Template for Backend/.env. Placeholders only: never put real secrets here.
# CI copies this file to .env, so every required setting needs a value.

# Matches the db service in docker-compose.yml (local/CI only)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/app
JWT_SECRET=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXP_MINUTES=60
APP_NAME=Warehouse Operations Service
REFRESH_TOKEN_SALT=change-me-refresh-salt

# Reset emails go through Brevo; without BREVO_API_KEY sending is skipped
BREVO_API_KEY=
SMTP_HOST=smtp.example.com
SMTP_USE_TLS=true
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-app-password-here
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=Warehouse Operations Service

PASSWORD_RESET_CODE_TTL_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_CODE_SALT=change-me-reset-code-salt
